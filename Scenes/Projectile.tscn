[sub_resource type="CSharpScript" id="CSharpScript_tomee"]
script/source = "using Godot;
using System;
using System.ComponentModel;

public partial class CritComponent : Node
{
	[Export] public float CritChance { get; set; } = 0.05f; // 5 percent
	[Export] public int CritMultiplier { get; set; } = 2;

	public override void _Ready()
	{
	}

	public override void _Process(double delta)
	{
	}

	public bool IsCriticalHit()
	{
		if (CritChance >= 1f)
			return true;
		
		return GD.Randf() < CritChance;
	}
}
"

